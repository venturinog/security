/**
 * Cuenta los baneos de fail2ban por país, en las dos familias. Se usa en el
 * mapa GeoIP (`sec_geoip_map`). Las cadenas son `f2b-<jail>` y existen en
 * `iptables` y en `ip6tables` por separado desde que el baneo es dual-stack.
 */
function fail2banblocked() {
    $blocked=array();
    foreach (array('/usr/sbin/iptables', '/usr/sbin/ip6tables') as $ipt) {
        $output = $return = NULL;
        exec($ipt." -vnL 2>/dev/null | grep f2b | grep Chain | awk '{ print \$2 }'", $output, $return);
        if (!is_array($output)) continue;

        foreach($output as $line) {
            $chain = trim((string)$line);
            // Sólo nombres de cadena válidos: la salida se usa para armar un
            // comando de shell.
            if (!preg_match('/^[A-Za-z0-9_.-]+$/', $chain)) continue;

            $output2 = $return2 = NULL;
            exec($ipt.' -nL '.escapeshellarg($chain)." | grep 'DROP\\|REJECT' | awk '{ print \$4 }'", $output2, $return2);
            if (!is_array($output2)) continue;

            foreach($output2 as $ip) {
                $ip = trim((string)$ip);
                if ($ip === '' || $ip === '0.0.0.0/0' || $ip === '::/0') continue;
                $country = geoip_country_code($ip);
                if(!isset($blocked[$country])) { $blocked[$country]=0; }
                $blocked[$country]++;
            }
        }
    }
    echo json_encode($blocked,1);
}

function homecountry() {
    // Sin consultas externas: se usa la IP de origen de la ruta por defecto.
    $ip = '';
    exec("/usr/sbin/ip -4 route get 1.1.1.1 2>/dev/null", $output, $return);
    if ($return == 0 && isset($output[0]) && preg_match('/\bsrc (\S+)/', $output[0], $m)) {
        $ip = $m[1];
    }
    if ($ip === '') {
        echo 'ZZ';
        return;
    }
    echo geoip_country_code($ip) . "," . $ip;
}

