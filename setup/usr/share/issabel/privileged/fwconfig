// Parser de opciones largo propio. Antes se usaba Console_Getopt de PEAR,
// que no esta declarado en el spec y en EL10 puede no estar instalado (B1).
// El formato que devuelve imita a Console_Getopt: array($opciones, $no_opts),
// con cada opcion como array('--nombre', valor|null).
function fw_getopt($argv, $spec)
{
    $options = array();
    $nonOpts = array();
    $wants = array();
    foreach ($spec as $s) {
        if (substr($s, -1) === '=') $wants[substr($s, 0, -1)] = TRUE;
        else $wants[$s] = FALSE;
    }
    for ($i = 1; $i < count($argv); $i++) {
        $arg = $argv[$i];
        if (strncmp($arg, '--', 2) !== 0) { $nonOpts[] = $arg; continue; }
        $name = substr($arg, 2);
        $value = NULL;
        $eq = strpos($name, '=');
        if ($eq !== FALSE) {
            $value = substr($name, $eq + 1);
            $name = substr($name, 0, $eq);
        }
        if (!array_key_exists($name, $wants)) {
            fwrite(STDERR, "Unknown option --$name\n");
            return FALSE;
        }
        if ($wants[$name] && $value === NULL) {
            // Se acepta tanto --opt=valor como --opt valor: los helpers y
            // las llamadas historicas usan la forma con espacio.
            if (isset($argv[$i + 1]) && strncmp($argv[$i + 1], '--', 2) !== 0) {
                $value = $argv[++$i];
            } else {
                fwrite(STDERR, "Option --$name requires a value\n");
                return FALSE;
            }
        }
        if (!$wants[$name] && $value !== NULL) {
            fwrite(STDERR, "Option --$name does not take a value\n");
            return FALSE;
        }
        $options[] = array('--'.$name, $value);
    }
    return array($options, $nonOpts);
}

