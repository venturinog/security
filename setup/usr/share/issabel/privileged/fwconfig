function error_exit($sMsg, $errorcode = 1)
{
    fwrite(STDERR, $sMsg);
    exit($errorcode);
}

/**
 * Flag root-owned que impide apagar el firewall desde la GUI. La consola
 * puede saltarlo con --force; la web no, porque el POST de desactivacion
 * llama a `fwconfig --flush` sin ese flag.
 */
function _fwLockDir()  { return '/etc/issabel/firewall'; }
function _fwLockFile() { return _fwLockDir().'/locked'; }

function is_locked()
{
    return file_exists(_fwLockFile());
}

function set_lock($value)
{
    $value = strtolower(trim((string)$value));
    if ($value !== 'on' && $value !== 'off') {
        fputs(STDERR, "ERR: --lock expects on|off\n");
        return FALSE;
    }
    $dir = _fwLockDir();
    if (!is_dir($dir) && !@mkdir($dir, 0750, true)) {
        fputs(STDERR, "ERR: could not create $dir\n");
        return FALSE;
    }
    if ($value === 'on') {
        if (@file_put_contents(_fwLockFile(), "locked\n") === FALSE) {
            fputs(STDERR, "ERR: could not create ". _fwLockFile() ."\n");
            return FALSE;
        }
        @chmod(_fwLockFile(), 0640);
    } else {
        if (file_exists(_fwLockFile()) && !@unlink(_fwLockFile())) {
            fputs(STDERR, "ERR: could not remove ". _fwLockFile() ."\n");
            return FALSE;
        }
    }
    return TRUE;
}

function _fwOptPresent($opt, $name)
{
    if (!is_array($opt) || !isset($opt[0]) || !is_array($opt[0])) return FALSE;
    foreach ($opt[0] as $o) {
        if (isset($o[0]) && $o[0] === $name) return TRUE;
    }
    return FALSE;
}

// Flush all firewall rules and remove all chains.
function action_flushFirewall($opt)
{
    if (is_locked() && !_fwOptPresent($opt, '--force')) {
        fputs(STDERR, "ERR: the firewall is locked; use --force from the console to override\n");
        return FALSE;
    }
    file_put_contents("/etc/sysconfig/iptables",""); // Se blanque ese archivo para que no se vuelvan a cargar las reglas al reiniciar el servidor
    $ret = NULL;
    foreach (array(
        '/usr/sbin/iptables -F',
        '/usr/sbin/iptables -X',
        '/usr/sbin/iptables -Z',
        '/usr/sbin/iptables -t nat -F',
        ) as $cmd) {
        system($cmd, $ret);
        if ($ret) return FALSE;
    }
    // IPv6 se retira solo si el firewall de Issabel estaba cargado: si el
    // operador nunca lo encendio, no se tocan reglas v6 de terceros.
    if (_fwFamilyLoaded('inet6')) _fwTeardownFamily('inet6');
    @unlink('/run/issabel-fw-safemode');
    _fwResponsiveFlush();
    manageF2B('same');
    return TRUE;
}

// Load all the firewall rules from the database
function action_loadFirewall($opt)
{

    $dispGEOIP  = FALSE;   // se resuelve por familia tras leer la base
    $dispGEOIP6 = FALSE;

    $bExito = TRUE;
    $bFirewallActivo = FALSE;
    $bIpv6 = FALSE;
    // Cadenas por familia. Los nombres se repiten porque iptables e ip6tables
    // son tablas independientes; el mapa es el mismo para las dos y las
    // cadenas _GEOIP existen tambien en IPv6 desde F6.
    $issabelChains = array(
        'INPUT'           =>  'ISSABEL_INPUT',
        'OUTPUT'          =>  'ISSABEL_OUTPUT',
        'FORWARD'         =>  'ISSABEL_FORWARD',
        'ISSABEL_INPUT'   =>  'ISSABEL_INPUT_GEOIP',
        'ISSABEL_OUTPUT'  =>  'ISSABEL_OUTPUT_GEOIP',
        'ISSABEL_FORWARD' =>  'ISSABEL_FORWARD_GEOIP'
    );

    $rules = array();
    $mycontinent = array();

    try {


        $connCountries = new PDO('sqlite:/var/www/db/countries.db');
        $query = "SELECT continent_code AS continent,group_concat(code) AS countries FROM countries GROUP BY continent_code";
        $sth = $connCountries->query($query);
        $continents = $sth->fetchAll(PDO::FETCH_ASSOC);
        foreach($continents as $idx=>$data) {
            $mycontinent[$data['continent']]=$data['countries'];
        }

        $conn = new PDO('sqlite:/var/www/db/iptables.db');
        // Fix missing fields in some Issabel installations. Van con guarda para
        // no repetir el ALTER del version_sql (una instalacion limpia aplica
        // esquema y migraciones, y SQLite aborta por columna duplicada).
        $sth = $conn->query('SELECT * FROM filter LIMIT 1');
        $rules = $sth->fetchAll(PDO::FETCH_ASSOC);
        if (count($rules) > 0 && !array_key_exists('state', $rules[0])) {
            fputs(STDERR, "DEBUG: arreglando filter.state faltante...\n");
            $conn->query('ALTER TABLE filter ADD COLUMN state varchar(50)');
        }
        if (count($rules) > 0 && !array_key_exists('family', $rules[0])) {
            fputs(STDERR, "DEBUG: arreglando filter.family faltante...\n");
            $conn->query("ALTER TABLE filter ADD COLUMN family TEXT NOT NULL DEFAULT 'inet'");
        }
        if (count($rules) > 0 && !array_key_exists('priority', $rules[0])) {
            fputs(STDERR, "DEBUG: arreglando filter.priority faltante...\n");
            $conn->query("ALTER TABLE filter ADD COLUMN priority varchar(10) NOT NULL DEFAULT 'normal'");
        } else {
            // La tabla puede estar vacia: el array de arriba no trae columnas.
            // Se comprueba el esquema para no dejar la SELECT de abajo sin
            // `priority` en una base antigua sin reglas.
            $hasPriority = FALSE;
            foreach ($conn->query('PRAGMA table_info(filter)')->fetchAll(PDO::FETCH_ASSOC) as $col) {
                if (isset($col['name']) && $col['name'] === 'priority') { $hasPriority = TRUE; break; }
            }
            if (!$hasPriority) {
                fputs(STDERR, "DEBUG: arreglando filter.priority faltante...\n");
                $conn->query("ALTER TABLE filter ADD COLUMN priority varchar(10) NOT NULL DEFAULT 'normal'");
            }
        }
        $rules = array();

        $wl = array();
        // Whitelist check
        $sth = $conn->query('SELECT ip_address FROM whitelist');
        if($sth) {
            $rules = $sth->fetchAll(PDO::FETCH_ASSOC);
            if (count($rules) > 0) {
                foreach($rules as $wlentry) {
                    $wl[] = $wlentry['ip_address'];
                }
            }
        }
        $rules = array();

        // Block List. La tabla puede no existir todavia si el version_sql
        // quedo diferido: se degrada a lista vacia, no se aborta la carga.
        $bl = array();
        try {
            $sth = $conn->query('SELECT ip_address FROM blocklist');
            if ($sth) {
                foreach ($sth->fetchAll(PDO::FETCH_ASSOC) as $blentry) {
                    $bl[] = $blentry['ip_address'];
                }
            }
        } catch (PDOException $e) {
            fputs(STDERR, "WARN: blocklist table is not available yet\n");
        }

        // Is the firewall active? IPv6 has its own opt-in flag and stays off
        // until the operator turns it on from the rules page.
        $sth = $conn->query('SELECT * FROM tmp_execute');
        foreach ($sth->fetchAll(PDO::FETCH_ASSOC) as $executeRow) {
            $bFirewallActivo = ($executeRow['first_time'] == 0);
            if (array_key_exists('ipv6_enabled', $executeRow)) {
                $bIpv6 = ($executeRow['ipv6_enabled'] == 1);
            } else {
                $conn->query('ALTER TABLE tmp_execute ADD COLUMN ipv6_enabled INTEGER NOT NULL DEFAULT 0');
            }
        }

        if ($bFirewallActivo) {
            // Read port-knocking configuration
            $sPeticionPK = <<<PETICION_PK
SELECT "INPUT" AS traffic,
    portknock_user_current_rule.eth_in AS eth_in,
    "" AS eth_out,
    portknock_user_current_rule.ip_source AS ip_source,
    "0.0.0.0/0" AS ip_destiny,
    port.protocol AS protocol,
    "ANY" AS sport,
    portknock_user_auth.id_port AS dport,
    "ACCEPT" AS target,
    "" AS state
FROM port, portknock_user_auth, portknock_user_current_rule
WHERE port.id = portknock_user_auth.id_port AND portknock_user_auth.id = portknock_user_current_rule.id_portknock_auth
PETICION_PK;
            $sth = $conn->query($sPeticionPK);
            $rules = array_merge($rules, $sth->fetchAll(PDO::FETCH_ASSOC));
    
            // Read port-knocking deny rules
            // TODO: agregar estado RELATED antes de DROP
            $sth = $conn->query('SELECT eth_in FROM portknock_eth');
            foreach ($sth->fetchAll(PDO::FETCH_COLUMN) as $eth_in) {
                $rules[] = array(
                    'traffic'       =>  'INPUT',
                    'eth_in'        =>  $eth_in,
                    'eth_out'       =>  '',
                    'ip_source'     =>  '0.0.0.0/0',
                    'ip_destiny'    =>  '0.0.0.0/0',
                    'protocol'      =>  'STATE',
                    'sport'         =>  '',
                    'dport'         =>  '',
                    'target'        =>  'ACCEPT',
                    'state'         =>  'Established,Related',
                );
                $rules[] = array(
                    'traffic'       =>  'INPUT',
                    'eth_in'        =>  $eth_in,
                    'eth_out'       =>  '',
                    'ip_source'     =>  '0.0.0.0/0',
                    'ip_destiny'    =>  '0.0.0.0/0',
                    'protocol'      =>  'ALL',
                    'sport'         =>  '',
                    'dport'         =>  '',
                    'target'        =>  'REJECT',
                    'state'         =>  '',
                );
            }
    
            // Read rule configuration from database
            $sth = $conn->query(
                'SELECT traffic, eth_in, eth_out, ip_source, ip_destiny, protocol, ' .
                    'sport, dport, target, state, countries, continents, family, priority ' .
                'FROM  filter WHERE activated = 1 ORDER BY rule_order');
            $rules = array_merge($rules, $sth->fetchAll(PDO::FETCH_ASSOC));
        }

        // El matcher y los datos se comprueban por familia: tener los .iv4 no
        // habilita IPv6 (las reglas no coincidirian y fallarian en silencio).
        $geoRules4 = 0;
        $geoRules6 = 0;
        foreach ($rules as $r) {
            if (!isset($r['protocol']) || $r['protocol'] !== 'GEOIP') continue;
            if (_fwRuleFamily($r) === 'inet6') $geoRules6++; else $geoRules4++;
        }
        if ($geoRules4 > 0) {
            $dispGEOIP = geoip_available('inet');
            if (!$dispGEOIP) {
                fputs(STDERR, "GeoIP rules are configured but the IPv4 geoip match is unavailable.\n"
                    . "Install xtables-addons (>= 3.27 for kernel 6.12) and generate /usr/share/xt_geoip "
                    . "(/etc/cron.daily/geoip_update.sh), then retry.\n");
                return FALSE;
            }
        }
        if ($geoRules6 > 0 && $bIpv6) {
            $dispGEOIP6 = geoip_available('inet6');
            if (!$dispGEOIP6) {
                fputs(STDERR, "IPv6 GeoIP rules are configured but the IPv6 geoip match or data is unavailable.\n"
                    . "Install xtables-addons (>= 3.27 for kernel 6.12) and generate /usr/share/xt_geoip "
                    . "with the .iv6 files (/etc/cron.daily/geoip_update.sh), then retry.\n");
                return FALSE;
            }
        }
    } catch (PDOException $e) {            
        $bExito = FALSE;
        fprintf(STDERR, "ERR: failed to query firewall rules - %s\n", $e->getMessage());
    }

    // Flush all firewall rules
    if ($bExito) {
        // Cierra un 80 que quedó abierto por un certbot interrumpido, salvo
        // que haya un certbot en curso.
        if (trim((string)shell_exec('pgrep -f "[c]ertbot" 2>/dev/null')) === '') {
            _fwLeClose();
        }
        $bExito = _fwFlushFamily('inet');
    }

    // IPv6 se retira cuando el operador lo apaga: sin esto, quitar el switch
    // dejaria las cadenas v6 cargadas hasta el reinicio.
    if ($bExito && !$bIpv6 && _fwFamilyLoaded('inet6')) {
        _fwTeardownFamily('inet6');
    }
    if ($bExito && $bIpv6) {
        $bExito = _fwFlushFamily('inet6');
    }

    // Add ISSABEL_XXX chains to iptables configuration if not already present
    if ($bExito && $bFirewallActivo) {
        // Los sets existen antes que las reglas que los referencian, y con el
        // tipo correcto: en 5.x eran hash:ip, que no acepta redes.
        $bExito = _fwEnsureWhitelistSets();
        if ($bExito) $bExito = _fwEnsureBlocklistSets();
        if ($bExito) $bExito = _fwCreateChains('inet', $issabelChains);
        if ($bExito && $bIpv6) $bExito = _fwCreateChains('inet6', $issabelChains);
        if ($bExito) $bExito = _fwInitAuxChains('inet');
        if ($bExito && $bIpv6) $bExito = _fwInitAuxChains('inet6');
        if ($bExito) $bExito = _fwInitLeRule('inet');
        if ($bExito && $bIpv6) $bExito = _fwInitLeRule('inet6');
        $resp = _fwResponsiveSettings();
        if ($bExito && !empty($resp['enabled'])) {
            $bExito = _fwEnsureResponsiveSets($resp);
            if ($bExito) $bExito = _fwInitResponsive('inet', $resp);
            if ($bExito && $bIpv6) $bExito = _fwInitResponsive('inet6', $resp);
        }
        // Reglas propias del operador, antes de las normales para que no
        // queden detras del REJECT final.
        if ($bExito) $bExito = _fwApplyCustomRules('inet');
        if ($bExito && $bIpv6) $bExito = _fwApplyCustomRules('inet6');
    }

    // Add rules to ISSABEL_XXX chains
    if ($bExito && $bFirewallActivo) {
        $bExito = _fwApplyRules($rules, 'inet', $issabelChains, $mycontinent, $conn, $dispGEOIP);

        if ($bExito && $bIpv6) {
            $bExito = _fwApplyRules($rules, 'inet6', $issabelChains, $mycontinent, $conn, $dispGEOIP6);

            // Default-DENY de IPv6, siempre al final de la cadena: una regla
            // nueva queda por encima y nadie puede dejar IPv6 en fail-open
            // borrandolo desde la UI (no es una fila de `filter`).
            if ($bExito) {
                $ret = NULL;
                system('/usr/sbin/ip6tables -A ISSABEL_INPUT -j REJECT', $ret);
                if (!$ret) system('/usr/sbin/ip6tables -A ISSABEL_FORWARD -j REJECT', $ret);
                if ($ret) $bExito = FALSE;
            }

            // Si IPv6 fallo a medias no se deja la familia parcialmente
            // aplicada: se retira para que el operador pueda reintentar.
            if (!$bExito) {
                fputs(STDERR, "ERR: IPv6 rules could not be applied, tearing IPv6 down\n");
                _fwTeardownFamily('inet6');
            }
        }
    }
    
    // Engancha las cadenas en las built-in. Se hace después de aplicar las
    // reglas para que ISSABEL_PRE quede antes de ISSABEL_INPUT.
    if ($bExito && $bFirewallActivo) {
        $bExito = _fwInstallJumps('inet', $issabelChains);
        if ($bExito && $bIpv6) $bExito = _fwInstallJumps('inet6', $issabelChains);
    }

    // Add White List check to INPUT, en las dos familias. Sólo con el firewall
    // activo: sin cadenas de Issabel no hay nada que exceptuar (y los sets se
    // crean en ese mismo bloque).
    if ($bExito && $bFirewallActivo) {
        $cmd = "/usr/sbin/iptables -I INPUT -m set --match-set issabel_whitelist src -j ACCEPT";
        system($cmd, $ret);
        if ($ret) {
            fputs(STDERR, "ERR: could not hook the IPv4 whitelist into INPUT\n");
            $bExito = FALSE;
        }
        if ($bExito && $bIpv6) {
            $cmd = "/usr/sbin/ip6tables -I INPUT -m set --match-set issabel_whitelist6 src -j ACCEPT";
            system($cmd, $ret);
            if ($ret) {
                fputs(STDERR, "ERR: could not hook the IPv6 whitelist into INPUT\n");
                $bExito = FALSE;
            }
        }
    }
    if ($bExito && $bFirewallActivo) {
        $bExito = _fwLoadWhitelist($wl);
    }
    if ($bExito && $bFirewallActivo) {
        $bExito = _fwLoadBlocklist($bl);
    }

    // Save configuration to /etc/sysconfig/iptables
    if ($bExito) {
        $output = $ret = NULL;
        system('/usr/sbin/iptables-save > /etc/sysconfig/iptables', $ret);
        if ($ret) $bExito = FALSE;
    }
    if ($bExito && $bIpv6) {
        $output = $ret = NULL;
        system('/usr/sbin/ip6tables-save > /etc/sysconfig/ip6tables', $ret);
        if ($ret) $bExito = FALSE;
    }

    // Ensure that iptables will actually be restored on reboot
    if ($bExito) {
        $ret = NULL;
        system('/usr/bin/systemctl enable iptables.service', $ret);
        if ($ret) { $bExito = FALSE; }
    }
    if ($bExito && $bIpv6) {
        $ret = NULL;
        system('/usr/bin/systemctl enable ip6tables.service', $ret);
        if ($ret) { $bExito = FALSE; }
    }

    // Si el administrador aplica reglas durante Safe Mode, ese ruleset pasa a
    // ser el bueno y Safe Mode termina: no se debe restaurar el viejo a los
    // 5 minutos. fwrestore usa iptables-restore y no pasa por aquí.
    if ($bExito && file_exists('/run/issabel-fw-safemode')) {
        @mkdir('/var/lib/issabel/firewall', 0750, true);
        @copy('/etc/sysconfig/iptables', '/var/lib/issabel/firewall/full.rules');
        @unlink('/run/issabel-fw-safemode');
    }

    manageF2B('same');

    return $bExito;
}

/**
 * Binario de cada familia. Son tablas independientes: el nombre de la cadena
 * se repite, el que cambia es el comando.
 */
function _fwBinaries()
{
    return array(
        'inet'  => '/usr/sbin/iptables',
        'inet6' => '/usr/sbin/ip6tables',
    );
}

/**
 * Familia de una regla. Las filas anteriores a la columna `family` y las que
 * arma fwconfig en memoria (portknock) no la traen: son IPv4.
 */
function _fwRuleFamily($rule)
{
    if (!isset($rule['family'])) return 'inet';
    return ((string)$rule['family'] === 'inet6') ? 'inet6' : 'inet';
}

/**
 * Comprueba que un origen/destino pertenezca a la familia de la regla. Se usa
 * como guarda antes de emitir IPv6: descartar el matcher dejaria la regla
 * abierta a cualquier origen, que es peor que no cargarla.
 */
function _fwAddressesBelongToFamily($rule, $family)
{
    $flag = ($family === 'inet6') ? FILTER_FLAG_IPV6 : FILTER_FLAG_IPV4;
    foreach (array('ip_source', 'ip_destiny') as $field) {
        $value = trim((string)(isset($rule[$field]) ? $rule[$field] : ''));
        if ($value === '') continue;
        $parts = explode('/', $value);
        $address = $parts[0];
        if ($address === '0.0.0.0' || $address === '::') continue;
        if (!filter_var($address, FILTER_VALIDATE_IP, $flag)) return FALSE;
    }
    return TRUE;
}

/**
 * Indica si el firewall de Issabel tiene su cadena cargada en esa familia.
 */
function _fwFamilyLoaded($family)
{
    $bin = _fwBinaries();
    $output = $ret = NULL;
    exec($bin[$family].' -nL ISSABEL_INPUT 2>/dev/null', $output, $ret);
    return $ret == 0;
}

/**
 * Vacía las tablas de una familia. Para IPv4 se aborta si falla el flush de
 * `nat` (comportamiento historico); para IPv6 es best effort, porque el
 * soporte de esa tabla depende del kernel.
 */
function _fwFlushFamily($family)
{
    $bin = _fwBinaries();
    $ret = NULL;
    foreach (array('-F', '-X', '-Z', '-t nat -F') as $arg) {
        system($bin[$family].' '.$arg, $ret);
        if ($ret && $family === 'inet') return FALSE;
    }
    return TRUE;
}

/**
 * Retira el filtrado de una familia: cadenas, archivo de arranque y servicio.
 */
function _fwTeardownFamily($family)
{
    _fwFlushFamily($family);
    if ($family === 'inet6') {
        file_put_contents('/etc/sysconfig/ip6tables', '');
        $ret = NULL;
        system('/usr/bin/systemctl disable ip6tables.service >/dev/null 2>&1', $ret);
    }
    return TRUE;
}

/**
 * Cadenas auxiliares del orden nuevo: PRE (HIGH + BLOCK) y sus equivalentes
 * de FORWARD. Se crean siempre, aunque estén vacías: el salto desde la
 * built-in tiene que existir para que el orden sea determinista.
 */
function _fwAuxChains()
{
    return array(
        'ISSABEL_PRE',
        'ISSABEL_HIGH',
        'ISSABEL_BLOCK',
        'ISSABEL_PRE_FORWARD',
        'ISSABEL_HIGH_FORWARD',
    );
}

/**
 * Crea las cadenas ISSABEL_XXX que falten. No engancha saltos: eso lo hace
 * _fwInstallJumps() después de aplicar las reglas, para que PRE quede antes
 * de ISSABEL_INPUT y no al revés.
 */
function _fwCreateChains($family, $chains)
{
    $bin = _fwBinaries();
    $output = $ret = NULL;

    exec($bin[$family].' -L -n', $output, $ret);
    if ($ret) return FALSE;

    $currentChains = array();
    foreach ($output as $sLinea) {
        $regs = NULL;
        if (preg_match('/^Chain (\S+)/', $sLinea, $regs))
            $currentChains[] = $regs[1];
    }

    $wanted = array_merge(array_values($chains), _fwAuxChains());
    foreach (array_diff(array_unique($wanted), $currentChains) as $sChain) {
        system($bin[$family].' -N '.$sChain, $ret);
        if ($ret) return FALSE;
    }
    return TRUE;
}

/**
 * Engancha las cadenas en las built-in en el orden acordado:
 *
 *   INPUT 1 whitelist (lo inserta action_loadFirewall)
 *   INPUT 2 F2B_INPUT (lo inserta fail2ban)
 *   INPUT 3 ISSABEL_PRE
 *   INPUT 4 F2B_RBL (lo inserta la accion de packetbl)
 *   INPUT 5 ISSABEL_INPUT
 *
 * ISSABEL_PRE se inserta antes de que se agregue ISSABEL_INPUT; si F2B_INPUT
 * no existe todavía, iptables lo pega al final y fail2ban lo empuja a 2 al
 * arrancar.
 */
function _fwInstallJumps($family, $chains)
{
    $bin = _fwBinaries();
    $ret = NULL;

    if (!_ipt_insert_at('INPUT', 3, '-j ISSABEL_PRE', $family)) return FALSE;
    system($bin[$family].' -A INPUT -j '.$chains['INPUT'], $ret);
    if ($ret) return FALSE;

    if (!_ipt_insert_at('FORWARD', 1, '-j ISSABEL_PRE_FORWARD', $family)) return FALSE;
    system($bin[$family].' -A FORWARD -j '.$chains['FORWARD'], $ret);
    if ($ret) return FALSE;

    system($bin[$family].' -A OUTPUT -j '.$chains['OUTPUT'], $ret);
    if ($ret) return FALSE;

    return TRUE;
}

/**
 * Contenido fijo de las cadenas auxiliares. BLOCK usa el set de su familia;
 * los sets ya existen cuando se llama a esta función.
 */
function _fwInitAuxChains($family)
{
    $bin = _fwBinaries();
    $set = ($family === 'inet6') ? 'issabel_blocklist6' : 'issabel_blocklist';
    $ret = NULL;

    foreach (array(
        '-A ISSABEL_PRE -j ISSABEL_HIGH',
        '-A ISSABEL_PRE -j ISSABEL_BLOCK',
        '-A ISSABEL_PRE_FORWARD -j ISSABEL_HIGH_FORWARD',
        '-A ISSABEL_PRE_FORWARD -j ISSABEL_BLOCK',
        '-A ISSABEL_BLOCK -m set --match-set '.$set.' src -j DROP',
    ) as $rule) {
        system($bin[$family].' '.$rule, $ret);
        if ($ret) return FALSE;
    }
    return TRUE;
}

function _ipt_insert_at($chain, $pos, $rule, $family = 'inet')
{
    $bin = _ipt_bin($family);
    $out = $ret = NULL;
    // `iptables -I CADENA N` falla con "Index of insertion too big" si la
    // cadena tiene menos de N-1 reglas. --load vacia las cadenas antes de
    // engancharlas, asi que la posicion 3 de INPUT (despues de la whitelist y
    // de F2B_INPUT) todavia no existe en la primera activacion. Se limita a
    // "al final": fail2ban y packetbl reinsertan sus saltos en 2 y 4 al
    // reiniciarse y dejan el orden definitivo.
    exec($bin.' -S '.$chain.' 2>/dev/null', $out, $ret);
    if ($ret == 0) {
        $count = 0;
        foreach ($out as $line) {
            if (strncmp(ltrim($line), '-A ', 3) === 0) $count++;
        }
        $pos = min((int)$pos, $count + 1);
    }
    if ((int)$pos < 1) $pos = 1;

    exec($bin.' -w -I '.$chain.' '.(int)$pos.' '.$rule.' 2>&1', $out, $ret);
    if ($ret != 0) {
        fwrite(STDERR, implode("\n", $out)."\n");
        return false;
    }
    return true;
}

/**
 * Reglas propias del operador en /etc/issabel/firewall.d/*.rules (v4) y
 * *.rules6 (v6). Se aplican antes de las reglas normales, para que una regla
 * custom de ISSABEL_INPUT no quede detrás del REJECT final.
 *
 * Los ficheros deben ser root:root y no escribibles por grupo/otros, y no
 * pueden ser symlinks. Se valida con iptables-restore --test antes de tocar
 * el kernel; si algo falla, se aborta la carga entera.
 */
function _fwApplyCustomRules($family)
{
    $dir = '/etc/issabel/firewall.d';
    if (!is_dir($dir)) return TRUE;

    $suffix = ($family === 'inet6') ? '.rules6' : '.rules';
    $files = glob($dir.'/*'.$suffix);
    if (!is_array($files) || count($files) === 0) return TRUE;
    sort($files);

    $restore = ($family === 'inet6') ? '/usr/sbin/ip6tables-restore' : '/usr/sbin/iptables-restore';
    $out = $ret = NULL;

    foreach ($files as $file) {
        if (is_link($file)) {
            fputs(STDERR, "ERR: custom rules file $file is a symlink\n");
            return FALSE;
        }
        $st = @stat($file);
        if (!is_array($st) || $st['uid'] != 0 || ($st['mode'] & 0022) != 0) {
            fputs(STDERR, "ERR: custom rules file $file must be root:root and not group/world writable\n");
            return FALSE;
        }

        $out = $ret = NULL;
        exec($restore.' --test < '.escapeshellarg($file).' 2>&1', $out, $ret);
        if ($ret != 0) {
            fputs(STDERR, "ERR: custom rules file $file is invalid: ".implode(' ', $out)."\n");
            return FALSE;
        }

        $out = $ret = NULL;
        exec($restore.' --noflush < '.escapeshellarg($file).' 2>&1', $out, $ret);
        if ($ret != 0) {
            fputs(STDERR, "ERR: could not apply custom rules file $file: ".implode(' ', $out)."\n");
            return FALSE;
        }
    }
    return TRUE;
}

/**
 * Cadena donde se emite una regla. Las reglas High sólo se aceptan para
 * INPUT/FORWARD con target ACCEPT; el resto va a su cadena normal (o a la
 * _GEOIP si el protocolo es GEOIP).
 */
function _fwRuleChain($rule, $issabelChains)
{
    $traffic = isset($rule['traffic']) ? $rule['traffic'] : 'INPUT';
    $priority = isset($rule['priority']) ? (string)$rule['priority'] : 'normal';
    $target = isset($rule['target']) ? (string)$rule['target'] : '';
    $isHigh = ($priority === 'high' && $target === 'ACCEPT'
               && ($traffic === 'INPUT' || $traffic === 'FORWARD'));

    if ($isHigh) {
        return ($traffic === 'FORWARD') ? 'ISSABEL_HIGH_FORWARD' : 'ISSABEL_HIGH';
    }
    if ($rule['protocol'] == 'GEOIP') {
        return $issabelChains[$traffic].'_GEOIP';
    }
    return $issabelChains[$traffic];
}

/**
 * Emite las reglas de una familia. Las filas de la otra familia (y las GeoIP
 * cuando se emite IPv6) se saltan sin tocar sus matchers.
 */
function _fwApplyRules($rules, $family, $issabelChains, $mycontinent, $conn, $dispGEOIP)
{
    $bin = _fwBinaries();
    $ipt = $bin[$family];
    // "Sin origen/destino" es un /0 en cualquiera de las dos familias: no se
    // traduce una direccion de una familia a la otra, se omite el matcher (que
    // en las dos significa "cualquiera").
    $wildcards = array('0.0.0.0/0', '::/0', '');

    foreach ($rules as $rule) {
        if (_fwRuleFamily($rule) !== $family) continue;
        if (!isset($rule['protocol']) || $rule['protocol'] === '') continue;

        if (!_fwAddressesBelongToFamily($rule, $family)) {
            $ruleId = isset($rule['id']) ? $rule['id'] : '?';
            fputs(STDERR, "ERR: rule $ruleId has an address from another family, not loading it\n");
            return FALSE;
        }

        $commandParams = array(
                $ipt,
                );
        $commandParams[] = '-A '._fwRuleChain($rule, $issabelChains);
        $ip_destiny = isset($rule['ip_destiny']) ? (string)$rule['ip_destiny'] : '';
        $ip_source  = isset($rule['ip_source']) ? (string)$rule['ip_source'] : '';
        if (!in_array($ip_destiny, $wildcards, true))
            $commandParams[] = "-d ".escapeshellarg($ip_destiny);
        if (!in_array($ip_source, $wildcards, true))
            $commandParams[] = "-s ".escapeshellarg($ip_source);
        switch ($rule['protocol']) {
            case 'TCP':
            case 'UDP':
                $commandParams[] = "-p ".escapeshellarg($rule['protocol']);
                if ($rule['sport'] != 'ANY' && $rule['sport'] != "" && !is_null($rule['sport'])) {
                    $port = "";
                    try{
                        $result = $conn->prepare("SELECT details FROM port WHERE id=?");
                        $r = $result->execute(array($rule['sport']));
                        if (!$r) {
                            fputs(STDERR, "ERROR: failed to query firewall rules\n");
                            return FALSE;
                        }
                        $arrResult = array();
                        if ($result!=null) {
                            while($row = $result->fetch(PDO::FETCH_OBJ)) {
                                $arrResult[] = (array)$row;
                            }
                        } else {
                            fputs(STDERR, "ERROR: failed to query firewall rules\n");
                            return FALSE;
                        }
                        if(isset($arrResult[0]["details"])) {
                            $port = $arrResult[0]["details"];
                        } else {
                            fputs(STDERR, "ERROR: some port was not found in database\n");
                            return FALSE;
                        }
                    } catch (PDOException $e) {            
                        fprintf(STDERR, "ERR: failed to query firewall rules - %s\n", $e->getMessage());
                        return FALSE;
                    }
                    $commandParams[] = "--sport ".escapeshellarg($port);
                }
                if ($rule['dport'] != 'ANY' && $rule['dport'] != "" && !is_null($rule['dport'])) {
                    $port = "";
                    try{
                        $result = $conn->prepare("SELECT details FROM port WHERE id=?");
                        $r = $result->execute(array($rule['dport']));
                        if (!$r) {
                            fputs(STDERR, "ERROR: failed to query firewall rules\n");
                            return FALSE;
                        }
                        $arrResult = array();
                        if ($result!=null) {
                            while($row = $result->fetch(PDO::FETCH_OBJ)) {
                                $arrResult[] = (array)$row;
                            }
                        } else {
                            fputs(STDERR, "ERROR: failed to query firewall rules\n");
                            return FALSE;
                        }
                        if (isset($arrResult[0]["details"])) {
                            $port = $arrResult[0]["details"];
                        } else {
                            fputs(STDERR, "ERROR: some port was not found in database\n");
                            return FALSE;
                            }
                    } catch (PDOException $e) {            
                        fprintf(STDERR, "ERR: failed to query firewall rules - %s\n", $e->getMessage());
                        return FALSE;
                    }
                        $commandParams[] = "--dport ".escapeshellarg($port);
                }
                break;
            case 'ICMP':
                $commandParams[] = ($family === 'inet6') ? '-p ipv6-icmp' : '-p icmp';
                break;
            case 'IP':
                $commandParams[] = '-p ip';
                break;
            case 'STATE':
                $commandParams[] = "-m state --state ".escapeshellarg($rule['state']);
                break;
        }
    
        if ($rule['eth_in'] != 'ANY' && $rule['eth_in'] != '') {
            $commandParams[] = "-i ".escapeshellarg($rule['eth_in']);
        }
        if ($rule['eth_out'] != 'ANY' && $rule['eth_out'] != '') {
            $commandParams[] = "-o ".escapeshellarg($rule['eth_out']);
        }
        $subsetcommand = NULL;
        if ($rule['protocol'] == 'GEOIP' && $rule['target'] == 'ACCEPT' && ($rule['countries'] != '' || $rule['continents'] != '')) {
    
            // expand continent into individual countries
            $countries=array();
    
            if($rule['continents']<>'') {
                $continents = explode(",",$rule['continents']);
                if(count($continents)>0) {
                    foreach($continents as $code=>$ctrystring) {
                        $countries = array_merge($countries,explode(",",$mycontinent[$ctrystring]));
                    }
                }
            }
    
            if($rule['countries']<>'') {
                $expcountries = explode(",",$rule['countries']);
                if(count($expcountries)>0) {
                    $countries = array_merge($countries,$expcountries);
                }
            }
    
            $countries = array_unique($countries);
            $cuantos_paises = count($countries);
    
            if($cuantos_paises<10) {
                $commandParams[] = "-m geoip --src-cc ".implode(',', $countries)." -j ".escapeshellarg('RETURN');
            } else {
                // split countries in multiple commands because of limit in geoip matching
                $subsetcommand = array();
                $comando_hasta_ahora = implode(' ',$commandParams);
                $paises = array_chunk($countries,10);
                foreach($paises as $subset) {
                    $impsubset = implode(",",$subset);
                    $subsetcommand[] = $comando_hasta_ahora . " -m geoip --src-cc ".escapeshellarg($impsubset)." -j ".escapeshellarg('RETURN');
                }
            }

        } else if ($rule['protocol'] == 'GEOIP' && ($rule['countries'] != '' || $rule['continents'] != '' )) {

            // expand continent into individual countries
            $countries=array();

            if($rule['continents']<>'') {
                $continents = explode(",",$rule['continents']);
                if(count($continents)>0) {
                    foreach($continents as $code=>$ctrystring) {
                        $countries = array_merge($countries,explode(",",$mycontinent[$ctrystring]));
                    }
                }
            }

            if($rule['countries']<>'') {
                $expcountries = explode(",",$rule['countries']);
                if(count($expcountries)>0) {
                    $countries = array_merge($countries,$expcountries);
                }
            }

            $countries = array_unique($countries);
            $cuantos_paises = count($countries);

            if($cuantos_paises<10) {
                $commandParams[] = "-m geoip --src-cc ".implode(',', $countries)." -m state --state NEW -j ".escapeshellarg($rule['target']);
            } else {
                // split countries in multiple commands because of limit in geoip matching
                $subsetcommand = array();
                $comando_hasta_ahora = implode(' ',$commandParams);
                $paises = array_chunk($countries,10);
                foreach($paises as $subset) {
                    $impsubset = implode(",",$subset);
                    $subsetcommand[] = $comando_hasta_ahora . " -m geoip --src-cc ".escapeshellarg($impsubset)." -m state --state NEW -j ".escapeshellarg($rule['target']);
                }
            }

        } else {
            $commandParams[] = "-j ".escapeshellarg($rule['target']);
        } 
        $ret = NULL;
        if (($rule['protocol'] != 'GEOIP') || ($rule['protocol'] == 'GEOIP' && $dispGEOIP)) {
            if(isset($subsetcommand)) {
                foreach($subsetcommand as $cmd) {
                    system($cmd,$ret);
                }
                unset($subsetcommand);
            } else {
                system(implode(' ', $commandParams), $ret);
            }
        }
    
        if ($ret) return FALSE;
    }

    return TRUE;
}

/**
 * Sets de la whitelist. Un set de ipset tiene una sola familia, asi que cada
 * una lleva el suyo. `hash:net` (y no `hash:ip`) porque la validacion del
 * modulo acepta redes: hash:ip rechaza cualquier entrada con prefijo.
 */
function _fwWhitelistSets()
{
    return array(
        'inet'  => array('name' => 'issabel_whitelist',  'family' => 'inet',  'type' => 'hash:net'),
        'inet6' => array('name' => 'issabel_whitelist6', 'family' => 'inet6', 'type' => 'hash:net'),
    );
}

/**
 * Set que corresponde a una entrada de la whitelist, o NULL si no es una
 * direccion valida. Acepta IP suelta o red con prefijo.
 */
function _fwWhitelistSetFor($value)
{
    $sets = _fwWhitelistSets();
    $parts = explode('/', trim((string)$value));
    $address = $parts[0];
    if (!filter_var($address, FILTER_VALIDATE_IP)) return NULL;
    $family = filter_var($address, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) ? 'inet6' : 'inet';
    return $sets[$family];
}

/**
 * Crea un set si falta y lo recrea si quedo con el tipo viejo (hash:ip). Al
 * recrear se pierden las entradas en el kernel: la carga de la whitelist las
 * vuelve a agregar desde la base.
 */
function _fwEnsureWhitelistSet($spec)
{
    $name = $spec['name'];
    $output = $ret = NULL;

    exec('/usr/sbin/ipset list -t '.$name.' 2>/dev/null', $output, $ret);
    if ($ret == 0) {
        $type = NULL;
        foreach ($output as $line) {
            if (preg_match('/^Type:\s*(\S+)/', $line, $m)) { $type = $m[1]; break; }
        }
        if ($type === $spec['type']) return TRUE;

        // Puede estar referenciado por una regla; en --load las cadenas ya se
        // vaciaron, asi que se puede destruir.
        $output = $ret = NULL;
        exec('/usr/sbin/ipset destroy '.$name.' 2>&1', $output, $ret);
        if ($ret != 0) {
            fputs(STDERR, "ERR: ipset $name has type ".$type." and cannot be recreated: "
                .implode(' ', $output)."\n");
            return FALSE;
        }
    }

    $output = $ret = NULL;
    exec('/usr/sbin/ipset -exist -N '.$name.' '.$spec['type']
        .' family '.$spec['family'].' hashsize 1024 maxelem 65536', $output, $ret);
    if ($ret != 0) {
        fputs(STDERR, "ERR: could not create ipset $name: ".implode(' ', $output)."\n");
        return FALSE;
    }
    return TRUE;
}

function _fwEnsureWhitelistSets()
{
    foreach (_fwWhitelistSets() as $spec) {
        if (!_fwEnsureWhitelistSet($spec)) return FALSE;
    }
    return TRUE;
}

/**
 * Reescribe el contenido de los sets desde la base. Se hace en cada carga para
 * que no queden entradas huerfanas (por ejemplo, las que dejaba la version
 * anterior al fallar el alta de una red).
 */
function _fwLoadWhitelist($wl)
{
    $output = $ret = NULL;
    foreach (_fwWhitelistSets() as $spec) {
        exec('/usr/sbin/ipset flush '.$spec['name'], $output, $ret);
        if ($ret != 0) {
            fputs(STDERR, "ERR: could not flush ipset ".$spec['name']."\n");
            return FALSE;
        }
    }

    foreach ($wl as $ip) {
        $spec = _fwWhitelistSetFor($ip);
        if ($spec === NULL) {
            fputs(STDERR, "ERR: invalid whitelist entry '$ip', skipped\n");
            continue;
        }
        exec('/usr/sbin/ipset add '.$spec['name'].' '.escapeshellarg($ip), $output, $ret);
        if ($ret != 0) {
            fputs(STDERR, "ERR: could not add '$ip' to ".$spec['name'].": "
                .implode(' ', $output)."\n");
            return FALSE;
        }
    }
    return TRUE;
}

function action_isactive6()
{
    exec("/usr/sbin/ip6tables -nL ISSABEL_INPUT", $output, $return);
    if ($return != 0) {
        echo "ISSABEL IPV6 FIREWALL disabled\n";
        return FALSE;
    } else {
        echo "ISSABEL IPV6 FIREWALL enabled\n";
        return TRUE;
    }
}

/**
 * Sets de la Block List. Mismo tipo que la whitelist: hash:net para aceptar
 * redes, una familia por set.
 */
function _fwBlocklistSets()
{
    return array(
        'inet'  => array('name' => 'issabel_blocklist',  'family' => 'inet',  'type' => 'hash:net'),
        'inet6' => array('name' => 'issabel_blocklist6', 'family' => 'inet6', 'type' => 'hash:net'),
    );
}

function _fwBlocklistSetFor($value)
{
    $sets = _fwBlocklistSets();
    $parts = explode('/', trim((string)$value));
    $address = $parts[0];
    if (!filter_var($address, FILTER_VALIDATE_IP)) return NULL;
    $family = filter_var($address, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) ? 'inet6' : 'inet';
    return $sets[$family];
}

function _fwEnsureBlocklistSets()
{
    foreach (_fwBlocklistSets() as $spec) {
        if (!_fwEnsureWhitelistSet($spec)) return FALSE;
    }
    return TRUE;
}

function _fwLoadBlocklist($bl)
{
    $output = $ret = NULL;
    foreach (_fwBlocklistSets() as $spec) {
        exec('/usr/sbin/ipset flush '.$spec['name'], $output, $ret);
        if ($ret != 0) {
            fputs(STDERR, "ERR: could not flush ipset ".$spec['name']."\n");
            return FALSE;
        }
    }

    foreach ($bl as $ip) {
        $spec = _fwBlocklistSetFor($ip);
        if ($spec === NULL) {
            fputs(STDERR, "ERR: invalid blocklist entry '$ip', skipped\n");
            continue;
        }
        exec('/usr/sbin/ipset add '.$spec['name'].' '.escapeshellarg($ip), $output, $ret);
        if ($ret != 0) {
            fputs(STDERR, "ERR: could not add '$ip' to ".$spec['name'].": "
                .implode(' ', $output)."\n");
            return FALSE;
        }
    }
    return TRUE;
}

/**
 * Set de puertos para la validación HTTP-01 de Let's Encrypt. Es un
 * bitmap:port (no una lista de IPs): mientras está vacío, el puerto está
 * cerrado; ssl_certbot añade el 80 justo antes de certbot y lo vacía después.
 */
function _fwLeportsName()
{
    return 'issabel_leports';
}

function _fwEnsureLeportsSet()
{
    $name = _fwLeportsName();
    $out = $ret = NULL;
    exec('/usr/sbin/ipset list -t '.$name.' 2>/dev/null', $out, $ret);
    if ($ret == 0) return TRUE;

    $out = $ret = NULL;
    exec('/usr/sbin/ipset -exist create '.$name.' bitmap:port range 0-65535', $out, $ret);
    if ($ret != 0) {
        fputs(STDERR, "ERR: could not create ipset $name: ".implode(' ', $out)."\n");
        return FALSE;
    }
    return TRUE;
}

function _fwLeOpen($port)
{
    $port = (int)$port;
    if ($port < 1 || $port > 65535) {
        fputs(STDERR, "ERR: invalid port '$port'\n");
        return FALSE;
    }
    // Sin firewall activo no hay regla que consulte el set: no-op.
    if (!_fwFamilyLoaded('inet')) return TRUE;
    if (!_fwEnsureLeportsSet()) return FALSE;

    $out = $ret = NULL;
    exec('/usr/sbin/ipset -exist add '._fwLeportsName().' '.$port, $out, $ret);
    if ($ret != 0) {
        fputs(STDERR, "ERR: could not add port $port to "._fwLeportsName().": "
            .implode(' ', $out)."\n");
        return FALSE;
    }
    return TRUE;
}

function _fwLeClose()
{
    $name = _fwLeportsName();
    $out = $ret = NULL;
    exec('/usr/sbin/ipset list -t '.$name.' 2>/dev/null', $out, $ret);
    if ($ret != 0) return TRUE; // nunca se creó: nada que cerrar
    $out = $ret = NULL;
    exec('/usr/sbin/ipset flush '.$name, $out, $ret);
    if ($ret != 0) {
        fputs(STDERR, "ERR: could not flush ipset $name: ".implode(' ', $out)."\n");
        return FALSE;
    }
    return TRUE;
}

/**
 * Regla que acepta los puertos del set en ISSABEL_INPUT. Va en posición 1
 * para quedar antes del REJECT final.
 */
function _fwInitLeRule($family)
{
    if (!_fwEnsureLeportsSet()) return FALSE;
    return _ipt_insert_at('ISSABEL_INPUT', 1,
        '-m set --match-set '._fwLeportsName().' dst,dst -j ACCEPT', $family);
}

function _fwResponsiveSettings()
{
    $defaults = array(
        'enabled' => 0, 'allow_timeout' => 7200, 'sip_port' => 5060,
        'rtp_start' => 10000, 'rtp_end' => 20000,
        'probe_rate' => 6, 'probe_burst' => 3,
    );
    try {
        $db = new SQLite3('/var/www/db/iptables.db');
        $db->busyTimeout(5000);
        $res = @$db->query("SELECT * FROM responsive WHERE id=1");
        $row = $res ? $res->fetchArray(SQLITE3_ASSOC) : false;
        $db->close();
        if (is_array($row)) return array_merge($defaults, $row);
    } catch (Exception $e) { /* tabla diferida: defaults */ }
    return $defaults;
}

function _fwResponsiveEnabled()
{
    $s = _fwResponsiveSettings();
    return !empty($s['enabled']);
}

function _fwResponsiveSetSpec($family, $settings)
{
    $timeout = max(60, (int)$settings['allow_timeout']);
    return array(
        'name'   => ($family === 'inet6') ? 'issabel_responsive6' : 'issabel_responsive',
        'family' => $family,
        'type'   => 'hash:ip',
        'timeout'=> $timeout,
    );
}

function _fwEnsureResponsiveSet($spec)
{
    $out = $ret = NULL;
    exec('/usr/sbin/ipset list -t '.$spec['name'].' 2>/dev/null', $out, $ret);
    if ($ret == 0) return TRUE;
    $out = $ret = NULL;
    exec('/usr/sbin/ipset -exist create '.$spec['name'].' hash:ip family '.$spec['family']
        .' timeout '.$spec['timeout'].' hashsize 1024 maxelem 65536', $out, $ret);
    if ($ret != 0) {
        fputs(STDERR, "ERR: could not create ipset ".$spec['name'].": ".implode(' ', $out)."\n");
        return FALSE;
    }
    return TRUE;
}

function _fwEnsureResponsiveSets($settings)
{
    foreach (array('inet', 'inet6') as $family) {
        if (!_fwEnsureResponsiveSet(_fwResponsiveSetSpec($family, $settings))) return FALSE;
    }
    return TRUE;
}

function _fwResponsiveFlush()
{
    $out = $ret = NULL;
    foreach (array('issabel_responsive', 'issabel_responsive6') as $name) {
        exec('/usr/sbin/ipset list -t '.$name.' 2>/dev/null', $out, $ret);
        if ($ret == 0) exec('/usr/sbin/ipset flush '.$name, $out, $ret);
    }
    return TRUE;
}

function _fwInitResponsive($family, $settings)
{
    $bin = _fwBinaries();
    $chain = 'ISSABEL_RESPONSIVE';
    $spec = _fwResponsiveSetSpec($family, $settings);
    if (!_fwEnsureResponsiveSet($spec)) return FALSE;

    $out = $ret = NULL;
    system($bin[$family].' -N '.$chain.' 2>/dev/null', $ret); // si ya existe, sigue
    if (!_ipt_insert_at('ISSABEL_INPUT', 1, '-j '.$chain, $family)) return FALSE;

    $sip = max(1, min(65535, (int)$settings['sip_port']));
    $rtpStart = max(1, min(65535, (int)$settings['rtp_start']));
    $rtpEnd = max($rtpStart, min(65535, (int)$settings['rtp_end']));
    $rate = max(1, (int)$settings['probe_rate']);
    $burst = max(1, (int)$settings['probe_burst']);
    $hname = ($family === 'inet6') ? 'sip_probe6' : 'sip_probe';

    $rules = array(
        '-A '.$chain.' -m set --match-set '.$spec['name'].' src -p udp --dport '.$sip.' -j ACCEPT',
        '-A '.$chain.' -m set --match-set '.$spec['name'].' src -p udp --dport '.$rtpStart.':'.$rtpEnd.' -j ACCEPT',
        '-A '.$chain.' -p udp --dport '.$sip
            .' -m hashlimit --hashlimit-name '.$hname.' --hashlimit-mode srcip'
            .' --hashlimit-upto '.$rate.'/min --hashlimit-burst '.$burst.' -j ACCEPT',
    );
    foreach ($rules as $rule) {
        system($bin[$family].' '.$rule, $ret);
        if ($ret) return FALSE;
    }
    return TRUE;
}

function _fwAmiPing()
{
    $fp = @fsockopen('127.0.0.1', 5038, $errno, $errstr, 2);
    if (!is_resource($fp)) return FALSE;
    fclose($fp);
    return TRUE;
}

function _fwAmiSecretFile()
{
    return '/etc/issabel/firewall/ami.secret';
}

function _fwResponsiveAmiUser($enable)
{
    $file = '/etc/asterisk/manager_custom.conf';
    $secretFile = _fwAmiSecretFile();

    if (!$enable) {
        if (is_file($file)) {
            $content = file_get_contents($file);
            $content = preg_replace('/\n?; BEGIN issabel-firewall.*?; END issabel-firewall\n?/s', "\n", $content);
            @file_put_contents($file, $content);
        }
        @unlink($secretFile);
        if (trim((string)shell_exec('pgrep -x asterisk 2>/dev/null')) !== '') {
            @exec('/usr/sbin/asterisk -rx "manager reload" 2>/dev/null');
        }
        return TRUE;
    }

    $dir = dirname($secretFile);
    if (!is_dir($dir) && !@mkdir($dir, 0750, true)) return FALSE;

    $secret = is_file($secretFile) ? trim(file_get_contents($secretFile)) : '';
    if ($secret === '') {
        $secret = bin2hex(random_bytes(16));
    }
    if (@file_put_contents($secretFile, $secret."\n") === FALSE) return FALSE;
    @chmod($secretFile, 0600);

    $content = is_file($file) ? file_get_contents($file) : '';
    $block = "; BEGIN issabel-firewall\n"
        ."[issabel-firewall]\n"
        ."secret = $secret\n"
        ."deny = 0.0.0.0/0.0.0.0\n"
        ."permit = 127.0.0.1/255.255.255.0\n"
        ."read = security,system\n"
        ."write =\n"
        ."; END issabel-firewall\n";

    if (preg_match('/; BEGIN issabel-firewall.*?; END issabel-firewall\n?/s', $content)) {
        $content = preg_replace('/; BEGIN issabel-firewall.*?; END issabel-firewall\n?/s', $block, $content);
    } else {
        $content = rtrim($content)."\n\n".$block;
    }
    if (@file_put_contents($file, $content) === FALSE) return FALSE;
    @chmod($file, 0640);
    @chown($file, 'asterisk');
    @chgrp($file, 'asterisk');

    if (trim((string)shell_exec('pgrep -x asterisk 2>/dev/null')) !== '') {
        @exec('/usr/sbin/asterisk -rx "manager reload" 2>/dev/null');
    }
    return TRUE;
}

function action_responsive($cmd)
{
    $cmd = strtolower(trim((string)$cmd));
    $settings = _fwResponsiveSettings();

    if ($cmd === 'status') {
        $state = $settings;
        $state['enabled'] = (int)$state['enabled'];
        $state['service'] = trim((string)shell_exec('/usr/bin/systemctl is-active issabel-fwresponsive 2>/dev/null'));
        echo json_encode($state, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES)."\n";
        return TRUE;
    }
    if ($cmd === 'flush') {
        _fwResponsiveFlush();
        @file_put_contents('/var/log/issabel/audit.log',
            sprintf("%s FIREWALL system: responsive.flush result=ok from local.\n", date('Y-m-d H:i:s')), FILE_APPEND);
        return TRUE;
    }
    if ($cmd === 'apply') {
        $ok = action_loadFirewall(array());
        if ($ok) @exec('/usr/bin/systemctl restart issabel-fwresponsive >/dev/null 2>&1');
        return $ok;
    }
    if ($cmd === 'on') {
        @exec('/usr/sbin/modprobe xt_hashlimit 2>/dev/null', $o, $r);
        if ($r != 0) {
            fputs(STDERR, "ERR: xt_hashlimit is not available\n");
            return FALSE;
        }
        if (!_fwResponsiveAmiUser(TRUE)) {
            fputs(STDERR, "ERR: could not create the AMI user\n");
            return FALSE;
        }
        if (!_fwAmiPing()) {
            fputs(STDERR, "ERR: AMI is not reachable on 127.0.0.1:5038\n");
            _fwResponsiveAmiUser(FALSE);
            return FALSE;
        }

        $db = new SQLite3('/var/www/db/iptables.db');
        $db->busyTimeout(5000);
        $db->exec("UPDATE responsive SET enabled=1 WHERE id=1");
        $db->close();

        if (!action_loadFirewall(array())) {
            $db = new SQLite3('/var/www/db/iptables.db');
            $db->exec("UPDATE responsive SET enabled=0 WHERE id=1");
            $db->close();
            _fwResponsiveAmiUser(FALSE);
            fputs(STDERR, "ERR: could not load the responsive rules\n");
            return FALSE;
        }
        @exec('/usr/bin/systemctl enable --now issabel-fwresponsive >/dev/null 2>&1', $o, $r);
        if ($r != 0) {
            $db = new SQLite3('/var/www/db/iptables.db');
            $db->exec("UPDATE responsive SET enabled=0 WHERE id=1");
            $db->close();
            action_loadFirewall(array());
            _fwResponsiveAmiUser(FALSE);
            fputs(STDERR, "ERR: could not start issabel-fwresponsive\n");
            return FALSE;
        }
        @file_put_contents('/var/log/issabel/audit.log',
            sprintf("%s FIREWALL system: responsive.enable result=ok from local.\n", date('Y-m-d H:i:s')), FILE_APPEND);
        return TRUE;
    }
    if ($cmd === 'off') {
        $db = new SQLite3('/var/www/db/iptables.db');
        $db->busyTimeout(5000);
        $db->exec("UPDATE responsive SET enabled=0 WHERE id=1");
        $db->close();

        action_loadFirewall(array());
        @exec('/usr/bin/systemctl disable --now issabel-fwresponsive >/dev/null 2>&1');
        _fwResponsiveFlush();
        _fwResponsiveAmiUser(FALSE);
        @file_put_contents('/var/log/issabel/audit.log',
            sprintf("%s FIREWALL system: responsive.disable result=ok from local.\n", date('Y-m-d H:i:s')), FILE_APPEND);
        return TRUE;
    }

    fputs(STDERR, "ERR: --responsive expects on|off|flush|status|apply\n");
    return FALSE;
}

function manageF2B($opt)
{
    switch ($opt) {
        case 'same':
            exec("systemctl -q is-active fail2ban", $output, $return);
            if ($return == 0) {
                echo "Ok, process is running, restarting\n";
                //exec("systemctl restart fail2ban", $output, $return);
                //uso service ya que systemctl no devuelve error en $return
                exec("systemctl restart fail2ban", $output, $ret);
                if ($ret != 0) {
                    echo "Fail2ban restart FAILED\n";
                }
            } else {
                echo "Fail2ban process is not running, do nothing\n";
            }
            break;
        case 'start':
            exec("pgrep fail2ban", $output, $return);
            if ($return == 0) {
                echo "Process already running\n";
            } else {
                //exec("systemctl start fail2ban", $output, $return);
                exec("systemctl start fail2ban", $output, $ret);
                if ($ret != 0) {
                    echo "Fail2ban start FAILED\n";
                }
            }
            break;
        case 'restart':
            //exec("systemctl restart fail2ban", $output, $return);
            exec("systemctl restart fail2ban", $output, $return);
            if ($return != 0) {
                echo "Fail2ban restart FAILED\n";
            }
            break;
        case 'stop':
            //exec("systemctl stop fail2ban", $output, $return);
            exec("systemctl stop fail2ban", $output, $return);
            if ($return != 0) {
                echo "Fail2ban stop FAILED\n";
            }
            break;
    }
}

/**
 * Comprueba las tres piezas necesarias para -m geoip: librería de usuarios,
 * módulo del kernel y datos binarios. `modprobe` a secas no basta: si el
 * módulo ya está cargado devuelve 0 aunque falte libxt_geoip.so.
 */
/**
 * Comprueba las tres piezas necesarias para `-m geoip`: librería de usuarios,
 * módulo del kernel y datos binarios. `modprobe` a secas no basta: si el
 * módulo ya está cargado devuelve 0 aunque falte libxt_geoip.so.
 *
 * Los datos son por familia: el matcher de IPv4 consume los `.iv4` y el de
 * IPv6 los `.iv6` de /usr/share/xt_geoip, que genera 20_build_xtables. Tener
 * una familia no habilita la otra (la regla quedaría sin coincidencias y sin
 * error visible), por eso cada familia se comprueba por separado.
 *
 * @param string $family  'inet' (IPv4) o 'inet6'
 */
function geoip_available($family = 'inet') {
    $hasLib = FALSE;
    foreach (array('/usr/lib64/xtables/libxt_geoip.so', '/usr/lib/xtables/libxt_geoip.so') as $lib) {
        if (is_file($lib)) { $hasLib = TRUE; break; }
    }
    if (!$hasLib) return FALSE;

    exec('/usr/sbin/modprobe xt_geoip 2>&1', $output, $return);
    if ($return != 0) return FALSE;

    $suffix = ($family === 'inet6') ? 'iv6' : 'iv4';
    $data = glob('/usr/share/xt_geoip/BE/*.'.$suffix);
    if (!$data) $data = glob('/usr/share/xt_geoip/LE/*.'.$suffix);
    if (empty($data)) return FALSE;

    // Comprobación final: que iptables/ip6tables pueda cargar el match
    // (backend nft incluido). Si falla aquí, tampoco funcionará en --load.
    $binaries = _fwBinaries();
    $output = $ret = NULL;
    exec($binaries[$family].' -w -m geoip -h 2>&1', $output, $ret);
    return $ret == 0;
}

function isactivegeoip() {
    if (!geoip_available('inet')) {
        echo "GeoIP match unavailable: install xtables-addons and generate /usr/share/xt_geoip\n";
        return FALSE;
    }
    return TRUE;
}

/**
 * Igual que isactivegeoip(), para la familia IPv6: exige los `.iv6` y que
 * ip6tables pueda cargar el match.
 */
function isactivegeoip6() {
    if (!geoip_available('inet6')) {
        echo "GeoIP IPv6 match unavailable: install xtables-addons and generate /usr/share/xt_geoip (.iv6)\n";
        return FALSE;
    }
    return TRUE;
}

/**
 * País de una dirección. Usa la base IPv6 cuando la dirección es v6: la base
 * legacy de libGeoIP vive en archivos distintos (GeoIP.dat / GeoIPv6.dat) y
 * `geoiplookup` no entiende direcciones v6.
 *
 * Acepta una dirección con prefijo ("2001:db8::7/128", como la imprime
 * `ip6tables -nL`) y lo descarta antes de consultar.
 */
function geoip_country_code($ip) {
    $ip = trim((string)$ip);
    $parts = explode('/', $ip);
    $address = $parts[0];

    $cmd = (strpos($address, ':') !== false) ? '/usr/bin/geoiplookup6' : '/usr/bin/geoiplookup';
    if (!is_file($cmd)) return 'ZZ';

    $output = $return = NULL;
    exec($cmd . ' ' . escapeshellarg($address) . ' 2>/dev/null', $output, $return);
    if ($return == 0 && isset($output[0]) && preg_match('/:\s*([A-Z]{2})\b/', $output[0], $m)) {
        return $m[1];
    }
    return 'ZZ';
}

function listgeopass() {

    // Las reglas de país se emiten en las dos familias; el mapa las muestra
    // una sola vez por código.
    $final = array();
    foreach (array('/usr/sbin/iptables', '/usr/sbin/ip6tables') as $ipt) {
        $output = $return = NULL;
        exec($ipt." -nL ISSABEL_INPUT_GEOIP 2>/dev/null | grep RETURN | awk '{print \$9}'", $output, $return);
        if ($return != 0 || !is_array($output)) continue;
        foreach($output as $line) {
            $line = trim((string)$line);
            if ($line !== '') $final[$line] = TRUE;
        }
    }
    echo implode(",", array_keys($final));
}


function listgeoblocked() {
