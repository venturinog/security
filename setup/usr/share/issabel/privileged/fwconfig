/**
 * Posición del salto -j <chain> dentro de una built-in, o NULL si no está.
 */
function _fwChainJumpPos($builtin, $chain)
{
    $out = shell_exec('/usr/sbin/iptables -S '.$builtin.' 2>/dev/null');
    if (!is_string($out) || trim($out) === '') return NULL;
    $pos = 0;
    foreach (explode("\n", $out) as $line) {
        $line = trim($line);
        if ($line === '') continue;
        $pos++;
        if (preg_match('/-j '.preg_quote($chain, '/').'\s*$/', $line)) return $pos;
    }
    return NULL;
}

/**
 * Comprobación de integridad. Devuelve JSON y sale 0 si todo cuadra.
 * No re-aplica nada: sólo informa.
 */
function action_check()
{
    $problems = array();
    $newInterfaces = array();
    $active = _fwFamilyLoaded('inet');

    if (!$active) {
        $problems[] = 'firewall is not active';
    } else {
        $f2b = _fwChainJumpPos('INPUT', 'F2B_INPUT');
        $pre = _fwChainJumpPos('INPUT', 'ISSABEL_PRE');
        $rbl = _fwChainJumpPos('INPUT', 'F2B_RBL');
        $in  = _fwChainJumpPos('INPUT', 'ISSABEL_INPUT');

        if ($pre === NULL) $problems[] = 'INPUT -j ISSABEL_PRE is missing';
        if ($f2b === NULL) $problems[] = 'INPUT -j F2B_INPUT is missing';
        if ($in  === NULL) $problems[] = 'INPUT -j ISSABEL_INPUT is missing';

        if ($f2b !== NULL && $pre !== NULL && $f2b > $pre)
            $problems[] = 'F2B_INPUT must be before ISSABEL_PRE';
        if ($pre !== NULL && $rbl !== NULL && $pre > $rbl)
            $problems[] = 'ISSABEL_PRE must be before F2B_RBL';
        if ($rbl !== NULL && $in !== NULL && $rbl > $in)
            $problems[] = 'F2B_RBL must be before ISSABEL_INPUT';
        if ($rbl === NULL && $pre !== NULL && $in !== NULL && $pre > $in)
            $problems[] = 'ISSABEL_PRE must be before ISSABEL_INPUT';

        $inputRules = (string)shell_exec('/usr/sbin/iptables -S INPUT 2>/dev/null');
        if (strpos($inputRules, 'issabel_whitelist') === false)
            $problems[] = 'the whitelist is not hooked into INPUT';

        foreach (array('issabel_whitelist', 'issabel_blocklist') as $set) {
            $names = trim((string)shell_exec('/usr/sbin/ipset list -n '.$set.' 2>/dev/null'));
            if ($names === '') $problems[] = "ipset $set is missing";
        }

        $f2bInput = (string)shell_exec('/usr/sbin/iptables -S F2B_INPUT 2>/dev/null');
        if (strpos($f2bInput, 'NFQUEUE') !== false)
            $problems[] = 'packetbl NFQUEUE is in F2B_INPUT; it must be in F2B_RBL';

        if (is_file('/etc/fail2ban/action.d/iptables-multiport-issabelrbl.conf')) {
            if ($rbl === NULL)
                $problems[] = 'INPUT -j F2B_RBL is missing';
            $f2bRbl = (string)shell_exec('/usr/sbin/iptables -S F2B_RBL 2>/dev/null');
            if (strpos($f2bRbl, 'NFQUEUE') === false)
                $problems[] = 'F2B_RBL does not contain the packetbl NFQUEUE rule';
        }

        exec('/usr/bin/systemctl -q is-active fail2ban', $o, $r);
        if ($r != 0) $problems[] = 'fail2ban is not active';

        $resp = _fwResponsiveSettings();
        if (!empty($resp['enabled'])) {
            $inputRules2 = (string)shell_exec('/usr/sbin/iptables -S INPUT 2>/dev/null');
            if (strpos($inputRules2, 'ISSABEL_RESPONSIVE') === false)
                $problems[] = 'responsive is enabled but ISSABEL_RESPONSIVE is not hooked into INPUT';
            foreach (array('issabel_responsive', 'issabel_responsive6') as $set) {
                $names = trim((string)shell_exec('/usr/sbin/ipset list -n '.$set.' 2>/dev/null'));
                if ($names === '') $problems[] = "ipset $set is missing";
            }
            exec('/usr/bin/systemctl -q is-active issabel-fwresponsive', $o2, $r2);
            if ($r2 != 0) $problems[] = 'issabel-fwresponsive is not active';
        }

        // Interfaces del sistema que no aparecen en ninguna regla.
        $known = array();
        try {
            $db = new SQLite3('/var/www/db/iptables.db');
            $res = $db->query("SELECT DISTINCT eth_in FROM filter WHERE eth_in<>'' AND eth_in<>'ANY'");
            if ($res) while ($row = $res->fetchArray(SQLITE3_ASSOC)) $known[$row['eth_in']] = true;
            $db->close();
        } catch (Exception $e) { /* sin DB, no se comprueba */ }
        foreach (glob('/sys/class/net/*') as $path) {
            $iface = basename($path);
            if ($iface === 'lo' || preg_match('/^(docker|veth|virbr|tun|tap)/', $iface)) continue;
            if (!isset($known[$iface])) $newInterfaces[] = $iface;
        }
    }

    $ok = (count($problems) === 0);
    $state = array(
        'ok'             => $ok,
        'active'         => $active,
        'locked'         => is_locked(),
        'safemode'       => file_exists('/run/issabel-fw-safemode'),
        'new_interfaces' => $newInterfaces,
        'problems'       => $problems,
    );
    echo json_encode($state, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES)."\n";

    if (!$ok && $active) {
        @file_put_contents('/var/log/issabel/audit.log',
            sprintf("%s FIREWALL system: integrity.check result=error msg=%s from local.\n",
                date('Y-m-d H:i:s'), escapeshellarg(implode('; ', $problems))),
            FILE_APPEND);
    }
    return $ok;
}

function add_whitelist($ip_address) {
    $spec = _fwWhitelistSetFor($ip_address);
    if ($spec === NULL) {
        fputs(STDERR, "ERR: '$ip_address' is not a valid IP address or network\n");
        return FALSE;
    }
    if (!_fwEnsureWhitelistSet($spec)) {
        return FALSE;
    }
    $output = $ret = NULL;
    exec('/usr/sbin/ipset -exist add '.$spec['name'].' '.escapeshellarg($ip_address), $output, $ret);
    if ($ret != 0) {
        fputs(STDERR, "ERR: could not add '$ip_address' to ".$spec['name'].": "
            .implode(' ', $output)."\n");
        return FALSE;
    }
    return generate_save_file();
}

function remove_whitelist($ip_address) {
    $spec = _fwWhitelistSetFor($ip_address);
    if ($spec === NULL) {
        fputs(STDERR, "ERR: '$ip_address' is not a valid IP address or network\n");
        return FALSE;
    }
    // Si el set no existe (firewall nunca cargado), no hay nada que quitar en
    // el kernel. Si existe pero la entrada no está, tampoco: la proxima carga
    // repuebla los sets desde la base, asi que el archivo es la referencia.
    $output = $ret = NULL;
    exec('/usr/sbin/ipset list -t '.$spec['name'].' 2>/dev/null', $output, $ret);
    if ($ret == 0) {
        $output = $ret = NULL;
        exec('/usr/sbin/ipset del '.$spec['name'].' '.escapeshellarg($ip_address), $output, $ret);
        if ($ret != 0) {
            fputs(STDERR, "WARN: could not remove '$ip_address' from ".$spec['name'].": "
                .implode(' ', $output)."\n");
        }
    }
    return generate_save_file();
}

function _fwResolveHost($host)
{
    $ips = array();
    $records = @dns_get_record($host, DNS_A | DNS_AAAA);
    if (is_array($records)) {
        foreach ($records as $r) {
            if (isset($r['ip']) && filter_var($r['ip'], FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
                $ips[] = $r['ip'];
            } elseif (isset($r['ipv6']) && filter_var($r['ipv6'], FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
                $ips[] = $r['ipv6'];
            }
        }
    }
    if (count($ips) === 0) {
        $v4 = gethostbyname($host);
        if ($v4 !== $host && filter_var($v4, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
            $ips[] = $v4;
        }
    }
    return array_values(array_unique($ips));
}

/**
 * Resuelve las entradas con hostname de la whitelist. `ip_address` sigue
 * siendo la IP efectiva; si cambia, se actualiza y se recarga el set.
 */
function resolve_whitelist()
{
    $db = new SQLite3('/var/www/db/iptables.db');
    $db->busyTimeout(5000);

    // Si el version_sql quedo diferido, la columna aun no existe: no es un
    // error del timer, se reintenta en la siguiente pasada.
    $hasHostname = false;
    $cols = $db->query("PRAGMA table_info(whitelist)");
    if ($cols) {
        while ($c = $cols->fetchArray(SQLITE3_ASSOC)) {
            if (isset($c['name']) && $c['name'] === 'hostname') { $hasHostname = true; break; }
        }
    }
    if (!$hasHostname) {
        $db->close();
        return TRUE;
    }

    $res = $db->query("SELECT ip_address,hostname FROM whitelist WHERE hostname IS NOT NULL AND hostname<>''");
    if ($res === false) {
        fputs(STDERR, "ERR: could not read the whitelist\n");
        $db->close();
        return FALSE;
    }

    $changed = FALSE;
    while ($row = $res->fetchArray(SQLITE3_ASSOC)) {
        $ips = _fwResolveHost($row['hostname']);
        if (count($ips) === 0) continue;

        $new = $ips[0];
        if ($new !== $row['ip_address']) {
            $check = $db->querySingle("SELECT COUNT(*) FROM whitelist WHERE ip_address='".SQLite3::escapeString($new)."'");
            if ((int)$check > 0) continue; // otra fila ya usa esa IP

            $stmt = $db->prepare("UPDATE whitelist SET ip_address=?, resolved_at=datetime('now') WHERE hostname=?");
            $stmt->bindValue(1, $new, SQLITE3_TEXT);
            $stmt->bindValue(2, $row['hostname'], SQLITE3_TEXT);
            if ($stmt->execute() === false) continue;

            @file_put_contents('/var/log/issabel/audit.log',
                sprintf("%s FIREWALL system: whitelist.resolve host=%s old=%s new=%s result=ok from local.\n",
                    date('Y-m-d H:i:s'), $row['hostname'], $row['ip_address'], $new),
                FILE_APPEND);
            $changed = TRUE;
        } else {
            $db->exec("UPDATE whitelist SET resolved_at=datetime('now') WHERE hostname='".SQLite3::escapeString($row['hostname'])."'");
        }
    }
    $db->close();

    if ($changed) {
        $db = new SQLite3('/var/www/db/iptables.db');
        $wl = array();
        $res = $db->query("SELECT ip_address FROM whitelist");
        if ($res) while ($row = $res->fetchArray(SQLITE3_ASSOC)) $wl[] = $row['ip_address'];
        $db->close();
        if (_fwEnsureWhitelistSets()) _fwLoadWhitelist($wl);
        generate_save_file();
    }
    return TRUE;
}

