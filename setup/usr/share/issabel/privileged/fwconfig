function manageF2B($opt)
{
    switch ($opt) {
        case 'same':
            exec("systemctl -q is-active fail2ban", $output, $return);
            if ($return == 0) {
                echo "Ok, process is running, restarting\n";
                //exec("systemctl restart fail2ban", $output, $return);
                //uso service ya que systemctl no devuelve error en $return
                exec("systemctl restart fail2ban", $output, $ret);
                if ($ret != 0) {
                    echo "Fail2ban restart FAILED\n";
                }
            } else {
                echo "Fail2ban process is not running, do nothing\n";
            }
            break;
        case 'start':
            exec("pgrep fail2ban", $output, $return);
            if ($return == 0) {
                echo "Process already running\n";
            } else {
                //exec("systemctl start fail2ban", $output, $return);
                exec("systemctl start fail2ban", $output, $ret);
                if ($ret != 0) {
                    echo "Fail2ban start FAILED\n";
                }
            }
            break;
        case 'restart':
            //exec("systemctl restart fail2ban", $output, $return);
            exec("systemctl restart fail2ban", $output, $return);
            if ($return != 0) {
                echo "Fail2ban restart FAILED\n";
            }
            break;
        case 'stop':
            //exec("systemctl stop fail2ban", $output, $return);
            exec("systemctl stop fail2ban", $output, $return);
            if ($return != 0) {
                echo "Fail2ban stop FAILED\n";
            }
            break;
    }
}

/**
 * Comprueba las tres piezas necesarias para -m geoip: librería de usuarios,
 * módulo del kernel y datos binarios. `modprobe` a secas no basta: si el
 * módulo ya está cargado devuelve 0 aunque falte libxt_geoip.so.
 */
/**
 * Comprueba las tres piezas necesarias para `-m geoip`: librería de usuarios,
 * módulo del kernel y datos binarios. `modprobe` a secas no basta: si el
 * módulo ya está cargado devuelve 0 aunque falte libxt_geoip.so.
 *
 * Los datos son por familia: el matcher de IPv4 consume los `.iv4` y el de
 * IPv6 los `.iv6` de /usr/share/xt_geoip, que genera 20_build_xtables. Tener
 * una familia no habilita la otra (la regla quedaría sin coincidencias y sin
 * error visible), por eso cada familia se comprueba por separado.
 *
 * @param string $family  'inet' (IPv4) o 'inet6'
 */
function geoip_available($family = 'inet') {
    $hasLib = FALSE;
    foreach (array('/usr/lib64/xtables/libxt_geoip.so', '/usr/lib/xtables/libxt_geoip.so') as $lib) {
        if (is_file($lib)) { $hasLib = TRUE; break; }
    }
    if (!$hasLib) return FALSE;

    exec('/usr/sbin/modprobe xt_geoip 2>&1', $output, $return);
    if ($return != 0) return FALSE;

    $suffix = ($family === 'inet6') ? 'iv6' : 'iv4';
    $data = glob('/usr/share/xt_geoip/BE/*.'.$suffix);
    if (!$data) $data = glob('/usr/share/xt_geoip/LE/*.'.$suffix);
    if (empty($data)) return FALSE;

    // Comprobación final: que iptables/ip6tables pueda cargar el match
    // (backend nft incluido). Si falla aquí, tampoco funcionará en --load.
    $binaries = _fwBinaries();
    $output = $ret = NULL;
    exec($binaries[$family].' -w -m geoip -h 2>&1', $output, $ret);
    return $ret == 0;
}

function isactivegeoip() {
    if (!geoip_available('inet')) {
        echo "GeoIP match unavailable: install xtables-addons and generate /usr/share/xt_geoip\n";
        return FALSE;
